# =============================================================================
# Dogtoralia — Variables de entorno (plantilla)
# =============================================================================
# Copia este archivo a `.env.local` (apps/web) o `.env` según el contexto y
# completa los valores. NUNCA se commitean valores reales (CLAUDE.md §1).
#
# Convención de visibilidad:
#   [PÚBLICA]  Prefijo NEXT_PUBLIC_. Se incluye en el bundle del navegador.
#              Solo valores que pueden ser públicos (URLs, llaves anon/publishable).
#   [PRIVADA]  Solo servidor (Edge Functions, build, CI). Si una variable privada
#              se importa en código de cliente, la validación de `apps/web/src/env.ts`
#              lanza un error: nunca quitar esa protección.
# =============================================================================

# --- Aplicación -------------------------------------------------------------
# [PÚBLICA] URL base de la aplicación web (dominio definitivo pendiente de definición).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Valores locales: los imprime `pnpm db:start`. Valores de nube: dashboard del proyecto.
# [PÚBLICA] URL del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# [PÚBLICA] Llave anónima (anon). Segura para el navegador: RLS limita todo acceso.
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloca-aqui-la-llave-anon-local
# [PRIVADA] Llave service_role: OMITE RLS. Solo Edge Functions y CI. Jamás en clientes.
SUPABASE_SERVICE_ROLE_KEY=
# [PRIVADA] Cadena de conexión directa a PostgreSQL (migraciones/herramientas).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Autenticación (Supabase Auth) ------------------------------------------
# URLs de redirección que deben registrarse en Supabase (Auth → URL Configuration):
#   Site URL:      {NEXT_PUBLIC_APP_URL}
#   Redirect URLs: {NEXT_PUBLIC_APP_URL}/confirmar
#                  {NEXT_PUBLIC_APP_URL}/actualizar-contrasena
# La confirmación de correo se activa/desactiva en Supabase (local:
# supabase/config.toml → [auth.email] enable_confirmations). Ver docs/auth/.

# --- Correo transaccional (Resend) ------------------------------------------
# [PRIVADA] Modo de correo: "dev" (no envía, registra redactado) o "resend" (real).
EMAIL_MODE=dev
# [PRIVADA] API key de Resend (solo necesaria con EMAIL_MODE=resend).
RESEND_API_KEY=
# [PRIVADA] Remitente y respuesta (dominio definitivo pendiente; ejemplos provisionales).
EMAIL_FROM="Dogtoralia <notificaciones@dogtoralia.mx>"
EMAIL_REPLY_TO=soporte@dogtoralia.mx

# --- Notificaciones push (Firebase Cloud Messaging) — se integra en Fase 8/9 ---
# [PÚBLICA] Configuración web/móvil del proyecto Firebase (la protege FCM, no es secreta).
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# [PRIVADA] Credenciales de cuenta de servicio para enviar push desde el servidor
# (JSON codificado en base64).
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=

# --- Pagos (Stripe) — se integra post-MVP -----------------------------------
# [PÚBLICA] Llave publicable.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# [PRIVADA] Llave secreta.
STRIPE_SECRET_KEY=
# [PRIVADA] Secreto de firma de webhooks.
STRIPE_WEBHOOK_SECRET=

# --- WhatsApp (Meta WhatsApp Cloud API) — proveedor confirmado, se integra post-MVP ---
# [PRIVADA] Token de acceso permanente de la app de Meta.
WHATSAPP_ACCESS_TOKEN=
# [PRIVADA] ID del número de teléfono emisor en la Cloud API.
WHATSAPP_PHONE_NUMBER_ID=
# [PRIVADA] Token de verificación del webhook de mensajes.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Almacenamiento ----------------------------------------------------------
# [PRIVADA] Nombre del bucket privado de archivos clínicos (URLs firmadas, nunca público).
STORAGE_MEDICAL_FILES_BUCKET=medical-files
# Fotografías de mascotas: bucket privado `pet-photos` (creado por migración).
# Límite de tamaño (5 MB) y formatos (JPEG/PNG/WebP) son constantes de código
# (apps/web/src/lib/pets/photos-shared.ts).
# [PRIVADA] Duración en segundos de las URLs firmadas de fotografías (30-3600).
PET_PHOTO_SIGNED_URL_SECONDS=300

# --- Analítica (futura) -------------------------------------------------------
# [PÚBLICA] Ejemplo: dominio de un proveedor respetuoso de privacidad (por definir).
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# --- Pruebas E2E (Playwright) -------------------------------------------------
# [PRIVADA] E2E_AUTH=1 habilita los flujos completos contra Supabase local
# (requiere pnpm db:start y confirmación de correo deshabilitada).
E2E_AUTH=
# [PRIVADA] Ruta a un Chromium ya instalado (sandboxes sin descarga de navegadores).
PLAYWRIGHT_CHROMIUM_PATH=
